JWT_SECRET=dev-secret
MYSQL_ROOT_PASSWORD=password
DATABASE_URL=mysql://root:password@localhost:3306/sociallite

# image uploads, only needed when running the backend outside docker compose
# (start the S3 mock with `docker compose up s3`)
IMAGE_BUCKET=sociallite-images
S3_ENDPOINT=http://localhost:9090
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
